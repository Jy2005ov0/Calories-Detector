# Photo recognition and the AI coach (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
PORT=8787
# The AI features spend your Anthropic credit. Each network address gets 20 photos and 30 coach
# messages per 10 minutes; this caps all requests per day.
AI_DAILY_LIMIT=2000
# Number of proxies in front of the server (1 on Render/Fly/Railway, 2 with Cloudflare in front, 0 if none).
TRUST_PROXY=1

# Extra origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=
