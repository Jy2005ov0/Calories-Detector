# Photo recognition and the AI coach (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
PORT=8787

# Accounts & sync — stored in SQLite at this path (default data/app.db)
DATABASE_PATH=data/app.db

# Sign in with Google (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_WEB_CLIENT_ID=          # "Web application" client — used by the website and Android
GOOGLE_IOS_CLIENT_ID=          # "iOS" client — used by the iPhone app
GOOGLE_EXTRA_CLIENT_IDS=       # optional, comma-separated (e.g. the Android client)

# Sign in with Apple (Apple Developer → Certificates, Identifiers & Profiles)
APPLE_BUNDLE_ID=com.caloriesdetector.app   # the iOS app's bundle ID
APPLE_SERVICE_ID=              # a Services ID, needed for the website and Android
APPLE_REDIRECT_URL=            # https URL registered on that Services ID

# Extra origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=
