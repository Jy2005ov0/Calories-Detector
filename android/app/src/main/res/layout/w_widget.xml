<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_kcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="–"
            android:textColor="#FF7A1A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_kcal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingBottom="5dp"
            android:text="kcal left"
            android:textColor="#3A3A3C"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_protein"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="#1C1C1E"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#1C1C1E"
        android:textSize="13sp" />

    <Button
        android:id="@+id/w_add"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/w_widget_button"
        android:minWidth="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="+ 250 ml"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
