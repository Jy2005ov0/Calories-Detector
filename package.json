{
  "name": "calories-detector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "test:e2e": "playwright test",
    "screenshots": "rm -rf docs/screenshots && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project='iPhone 14' --retries=0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-health": "^8.11.7",
    "@capgo/capacitor-social-login": "8.5.11",
    "@zxing/library": "^0.23.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
